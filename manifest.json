{
  "manifest_version": 3,
  "name": "JobStacker",
  "version": "2.1.0",
  "description": "Job discovery, application tracking, and autofill.",
  "author": "Shaik Fayaz",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "cookies",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/jobs-tracker/*",
    "https://www.linkedin.com/jobs/*",
    "https://www.naukri.com/*",
    "https://www.wellfound.com/*",
    "https://wellfound.com/*",
    "https://www.wellfound.com/jobs/*",
    "https://wellfound.com/jobs/*",
    "https://wellfound.com/role/*",
    "https://www.indeed.com/*",
    "https://www.foundit.in/*",
    "https://internshala.com/*",
    "https://www.internshala.com/*",
    "https://script.google.com/*",
    "https://*.railway.app/*",
    "https://*.vercel.app/*",
    "https://*.render.com/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://localhost:5173/*",
    "https://127.0.0.1:5173/*",
    "https://jobstack-api.onrender.com/*",
    "https://jobstack-live.vercel.app/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://localhost:5173/*",
        "https://127.0.0.1:5173/*",
        "http://localhost:5000/*",
        "https://jobstack-live.vercel.app/*"
      ],
      "js": ["auth/webapp-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/jobs-tracker/*"],
      "js": ["content/applied-jobs/content-linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.naukri.com/*"],
      "js": ["content/applied-jobs/content-naukri.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://wellfound.com/*",
        "https://www.wellfound.com/*",
        "https://wellfound.com/jobs/applications*",
        "https://www.wellfound.com/jobs/applications*"
      ],
      "js": ["content/applied-jobs/content-wellfound.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://internshala.com/student/applications/*",
        "https://www.internshala.com/student/applications/*"
      ],
      "js": ["content/applied-jobs/content-internshala.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.naukri.com/*",
        "https://www.linkedin.com/jobs/*",
        "https://www.indeed.com/*",
        "https://www.foundit.in/*",
        "https://wellfound.com/jobs/*",
        "https://wellfound.com/role/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "content/discovery/filters/naukri-filters.js",
        "content/discovery/extractors/naukri.js",
        "content/discovery/extractors/wellfound.js",
        "content/discovery/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["autofill/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JobStacker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "commands": {
    "toggle-advanced-settings": {
      "suggested_key": {"default": "Alt+J"},
      "description": "Show or hide advanced settings"
    },
    "open-panel": {
      "suggested_key": {"default": "Ctrl+Shift+S"},
      "description": "Open JobStacker panel"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
